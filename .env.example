# Copy to .env and fill in. Leaving DB_* unset makes Django fall back to a local SQLite DB.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_HOST=

# Required for AI features (quick-add parsing, auto-categorize, ask, insights)
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5
ANTHROPIC_MODEL=
